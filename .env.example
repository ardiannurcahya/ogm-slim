# ===============================================================
# OGM-Slim Configuration Environment Variables
# ===============================================================

# Server Host & Port
HOST=127.0.0.1
PORT=8765

# Authentication Toggle (true = Protected with login / false = Direct open access)
OGM_AUTH_ENABLED=false

# Authentication Credentials (Used when OGM_AUTH_ENABLED=true)
OGM_API_KEY=ogm-slim-admin-secret-key-local
OGM_ADMIN_PASSWORD=admin-password-local

# Project & Database
OGM_PROJECT_ID=default
# OGM_DB_PATH=/root/.config/ogm-slim/memory.db
