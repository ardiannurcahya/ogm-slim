{
  "name": "ogm-lw",
  "version": "1.0.0",
  "description": "Persistent memory service & codebase knowledge graph for AI coding agents (Lightweight TypeScript Edition)",
  "main": "dist/index.js",
  "bin": {
    "ogm-lw": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "build": "tsup src/cli.ts src/index.ts --format esm,cjs --dts --clean",
    "start": "node dist/cli.js serve",
    "mcp": "tsx src/cli.ts mcp",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "memory",
    "knowledge-graph",
    "ast",
    "codebase-search",
    "sigmajs"
  ],
  "author": "ardiannurcahya",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
